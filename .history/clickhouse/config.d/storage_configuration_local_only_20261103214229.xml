<clickhouse>
    <!--
      Storage Configuration: Local-Only (No S3 Dependency)
      =====================================================
      Use this when S3/MinIO object storage is NOT yet deployed.
      Only the default local NVMe/SSD disk is active.

      When MinIO is deployed and validated:
        1. Switch Dockerfile to COPY storage_configuration.xml instead
        2. Restore required S3 env vars in docker-compose.prod-single.yml
        3. Rebuild and redeploy the image
        4. Verify with: SELECT name, path, type FROM system.disks
    -->
    <storage_configuration>
        <disks>
            <default>
                <keep_free_space_bytes>10737418240</keep_free_space_bytes> <!-- 10 GB free space safety margin -->
            </default>
            <!-- Separate local disk for cold volume (ClickHouse requires distinct disks per volume) -->
            <cold_local>
                <type>local</type>
                <path>/var/lib/clickhouse/cold/</path>
                <keep_free_space_bytes>10737418240</keep_free_space_bytes>
            </cold_local>
        </disks>

        <policies>
            <!--
              Compatibility shim: same policy and volume names as the full
              storage_configuration.xml so that DDL referencing
              storage_policy='hot_to_cold' and TTL TO VOLUME 'cold'
              works without modification.
              hot  = default local disk
              cold = cold_local disk (separate path, same physical storage)
              When S3/MinIO is deployed, switch to storage_configuration.xml.
            -->
            <hot_to_cold>
                <volumes>
                    <hot>
                        <disk>default</disk>
                    </hot>
                    <cold>
                        <disk>cold_local</disk>
                    </cold>
                </volumes>
            </hot_to_cold>

            <s3_only>
                <volumes>
                    <cold>
                        <disk>cold_local</disk>
                    </cold>
                </volumes>
            </s3_only>
        </policies>
    </storage_configuration>
</clickhouse>