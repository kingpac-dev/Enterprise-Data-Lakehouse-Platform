<clickhouse>
    <users>
        <!-- This file owns user provisioning; remove the image default user. -->
        <default remove="remove"/>

        <!-- Default admin user with credentials injected via environment variables -->
        <admin>
            <password from_env="CLICKHOUSE_ADMIN_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
                <ip>0.0.0.0/0</ip>
            </networks>
            <profile>admin_profile</profile>
            <quota>default</quota>
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
            <show_named_collections_secrets>1</show_named_collections_secrets>
        </admin>

        <!-- Service Accounts -->
        <etl_user>
            <password from_env="CLICKHOUSE_ETL_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
                <ip>0.0.0.0/0</ip>
            </networks>
            <profile>etl_profile</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT INSERT, SELECT ON raw.*</query>
                <query>GRANT SELECT ON core.*</query>
            </grants>
        </etl_user>

        <bi_user>
            <password from_env="CLICKHOUSE_BI_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
                <ip>0.0.0.0/0</ip>
            </networks>
            <profile>bi_profile</profile>
            <quota>bi_quota</quota>
            <grants>
                <query>GRANT SELECT ON mart.*</query>
                <query>GRANT SELECT ON serving.*</query>
            </grants>
        </bi_user>

        <api_user>
            <password from_env="CLICKHOUSE_API_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
                <ip>0.0.0.0/0</ip>
            </networks>
            <profile>api_profile</profile>
            <quota>api_quota</quota>
            <grants>
                <query>GRANT SELECT ON serving.*</query>
            </grants>
        </api_user>

        <monitoring_user>
            <password from_env="CLICKHOUSE_MONITORING_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
                <ip>0.0.0.0/0</ip>
            </networks>
            <profile>readonly_profile</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON system.*</query>
            </grants>
        </monitoring_user>
    </users>
</clickhouse>
