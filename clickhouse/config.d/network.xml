<clickhouse>
    <!-- Network Listen Configuration -->
    <!--
      The official Docker image already supplies IPv4/IPv6 wildcard
      listen_host entries in docker_related_config.xml. Repeating a wildcard
      here conflicts with the entrypoint's temporary 127.0.0.1 listener while
      first-run SQL is being initialized.
    -->

    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <interserver_http_port>9009</interserver_http_port>

    <!-- Maximum connection limits to protect memory -->
    <max_connections>1024</max_connections>
    <keep_alive_timeout>10</keep_alive_timeout>
</clickhouse>
