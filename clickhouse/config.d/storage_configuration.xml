<clickhouse>
    <!--
      Storage Configuration:
      Hot/Cold Storage Tiering policy combining local NVMe/SSD with S3-compatible Object Storage
    -->
    <storage_configuration>
        <disks>
            <!-- Hot local NVMe/SSD default disk -->
            <default>
                <keep_free_space_bytes>10737418240</keep_free_space_bytes> <!-- 10 GB free space safety margin -->
            </default>

            <!-- Cold S3-compatible Lake Storage Disk -->
            <s3_cold>
                <type>s3</type>
                <endpoint from_env="CLICKHOUSE_S3_ENDPOINT" replace="1">http://minio:9000/enterprise-data-lake/clickhouse_data/</endpoint>
                <access_key_id from_env="CLICKHOUSE_S3_ACCESS_KEY" replace="1">lakehouse_s3_access_key</access_key_id>
                <secret_access_key from_env="CLICKHOUSE_S3_SECRET_KEY" replace="1">lakehouse_s3_secret_change_me</secret_access_key>
                <region from_env="S3_REGION" replace="1">us-east-1</region>
                <support_batch_delete>true</support_batch_delete>
                <use_environment_credentials>false</use_environment_credentials>
                <!-- Local metadata caching layer for S3 objects -->
                <metadata_path>/var/lib/clickhouse/disks/s3_cold/</metadata_path>
                <cache_enabled>true</cache_enabled>
                <cache_path>/var/lib/clickhouse/cache/s3_cold/</cache_path>
                <cache_size>10737418240</cache_size> <!-- 10 GB read cache on local SSD -->
            </s3_cold>
        </disks>

        <policies>
            <!-- Hot-to-Cold Tiered Storage Policy with TTL Migration -->
            <hot_to_cold>
                <volumes>
                    <hot>
                        <disk>default</disk>
                        <max_data_part_size_bytes>10737418240</max_data_part_size_bytes>
                    </hot>
                    <cold>
                        <disk>s3_cold</disk>
                    </cold>
                </volumes>
                <move_factor>0.15</move_factor> <!-- Move to cold when hot volume has < 15% free space -->
            </hot_to_cold>

            <!-- Direct S3 Lake Policy for cold/historical archive tables -->
            <s3_only>
                <volumes>
                    <cold>
                        <disk>s3_cold</disk>
                    </cold>
                </volumes>
            </s3_only>
        </policies>
    </storage_configuration>
</clickhouse>
