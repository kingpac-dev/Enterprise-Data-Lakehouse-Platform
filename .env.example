# ==============================================================================
# Enterprise Data Lakehouse Platform - Environment Variables Template
# ==============================================================================
# COPY THIS FILE TO .env BEFORE DEPLOYING:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env containing production credentials to version control!
# ==============================================================================

# --- Environment & Project Info ---
ENVIRONMENT=dev
PROJECT_NAME=enterprise-data-lakehouse
COMPOSE_PROJECT_NAME=lakehouse

# Shared cross-stack Docker networks (created by the UAT core stack)
INTEGRATION_NETWORK=lakehouse-uat-integration
OBSERVABILITY_NETWORK=lakehouse-uat-observability

# --- ClickHouse Server Configuration ---
CLICKHOUSE_VERSION=26.8
# Host-facing ports. Container ports remain 8123/9000/9363.
CLICKHOUSE_PORT_HTTP=18123
CLICKHOUSE_PORT_NATIVE=19000
CLICKHOUSE_PORT_PROMETHEUS=19363
CLICKHOUSE_ADMIN_USER=admin
CLICKHOUSE_ADMIN_PASSWORD=change_this_admin_password_in_prod
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

# Service Account Passwords (Inject strong passwords in PROD)
CLICKHOUSE_ETL_PASSWORD=change_this_etl_password_in_prod
CLICKHOUSE_BI_PASSWORD=change_this_bi_password_in_prod
CLICKHOUSE_API_PASSWORD=change_this_api_password_in_prod
CLICKHOUSE_MONITORING_PASSWORD=change_this_monitoring_password_in_prod
CLICKHOUSE_BACKUP_PASSWORD=change_this_backup_password_in_prod

# --- ClickHouse Keeper Coordination & Multi-Host HA Routing ---
KEEPER_PORT_CLIENT=9181
KEEPER_PORT_RAFT=9234
# Physical/VM IP addresses for Host 01, Host 02, and Host 03 in Production HA
HOST_NODE1_IP=10.0.0.11
HOST_NODE2_IP=10.0.0.12
HOST_NODE3_IP=10.0.0.13

# --- S3 / MinIO Object Storage Configuration ---
# DEV/UAT uses local MinIO container; PROD connects to enterprise S3/Ceph/ECS
S3_ENDPOINT=minio:9000
S3_PORT=19090
S3_PUBLIC_ENDPOINT=http://localhost:19090
S3_BUCKET_LAKE=enterprise-data-lake
S3_ACCESS_KEY=lakehouse_s3_access_key
S3_SECRET_KEY=lakehouse_s3_secret_change_me
S3_REGION=us-east-1
MINIO_CONSOLE_PORT=19091

# --- Portainer Configuration ---
PORTAINER_PORT_HTTP=19002
PORTAINER_PORT_HTTPS=19443
PORTAINER_AGENT_PORT=19001

# --- Observability Stack ---
PROMETHEUS_PORT=19093
GRAFANA_PORT=13000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password_in_prod
LOKI_PORT=13100
SERVING_API_PORT=18000

# --- UAT Data Sources Stack (synthetic/masked data only) ---
SOURCE_POSTGRES_PORT=15432
SOURCE_POSTGRES_DB=source_uat
SOURCE_POSTGRES_USER=source_app
SOURCE_POSTGRES_PASSWORD=change_this_postgres_password
SOURCE_POSTGRES_CPU_LIMIT=1
SOURCE_POSTGRES_MEMORY_LIMIT=1G

SOURCE_MYSQL_PORT=13306
SOURCE_MYSQL_DB=source_uat
SOURCE_MYSQL_USER=source_app
SOURCE_MYSQL_PASSWORD=change_this_mysql_password
SOURCE_MYSQL_ROOT_PASSWORD=change_this_mysql_root_password
SOURCE_MYSQL_CPU_LIMIT=1
SOURCE_MYSQL_MEMORY_LIMIT=1G

SOURCE_MSSQL_PORT=11433
SOURCE_MSSQL_EDITION=Developer
SOURCE_MSSQL_SA_PASSWORD=Change_This_Mssql_SA_Password_123!
SOURCE_MSSQL_DB=source_uat
SOURCE_MSSQL_USER=source_app
SOURCE_MSSQL_PASSWORD=Change_This_Mssql_App_Password_123!
SOURCE_MSSQL_CPU_LIMIT=2
SOURCE_MSSQL_MEMORY_LIMIT=3G

SOURCE_MONGODB_PORT=17017
SOURCE_MONGODB_DB=source_uat
SOURCE_MONGODB_ROOT_USER=mongo_admin
SOURCE_MONGODB_ROOT_PASSWORD=change_this_mongodb_root_password
SOURCE_MONGODB_USER=source_app
SOURCE_MONGODB_PASSWORD=change_this_mongodb_app_password
SOURCE_MONGODB_CPU_LIMIT=1
SOURCE_MONGODB_MEMORY_LIMIT=1G

# --- Resource Allocations (Tune for DEV vs PROD) ---
CLICKHOUSE_CPU_LIMIT=4
CLICKHOUSE_MEMORY_LIMIT=8G
CLICKHOUSE_MEMORY_RESERVATION=4G

# --- Real-Time Streaming Stack (M02 - Redpanda / Kafka) ---
REDPANDA_ADVERTISED_HOST=TBD_UAT_HOST_OR_DNS
REDPANDA_PORT_KAFKA=19092
REDPANDA_PORT_ADMIN=19644
REDPANDA_CONSOLE_PORT=18088
