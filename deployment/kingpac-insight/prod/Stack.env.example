# KingPac Insight production candidate: template only, NOT a deployment approval.
# Set to a reviewed Harbor image with @sha256:<digest>; never use the UAT image.
INSIGHT_PROD_IMAGE=
# Host-local port, distinct from other services, chosen by the platform owner.
INSIGHT_PROD_PORT=

# Internal Keycloak OIDC settings. Use exact approved issuer/client and distinct group paths.
INSIGHT_OIDC_ISSUER=
INSIGHT_OIDC_CLIENT_ID=
INSIGHT_OIDC_GROUP_VIEWER=
INSIGHT_OIDC_GROUP_AUTHOR=
INSIGHT_OIDC_GROUP_ADMIN=

# Absolute paths on the target Docker host, rendered by the approved secret manager.
# These are FILE PATHS, never passwords, tokens, keys, or connection URIs.
INSIGHT_PROD_SECRET_KEY_SOURCE=
INSIGHT_PROD_METADATA_URI_SOURCE=
INSIGHT_PROD_REDIS_URI_SOURCE=
INSIGHT_PROD_OIDC_SECRET_SOURCE=
INSIGHT_PROD_METADATA_CA_SOURCE=
INSIGHT_PROD_REDIS_CA_SOURCE=
INSIGHT_PROD_IDENTITY_CA_SOURCE=

# Initial tuning values only; confirm against load and capacity tests.
INSIGHT_WEB_WORKERS=2
INSIGHT_WEB_THREADS=4
INSIGHT_GUNICORN_TIMEOUT=60
