# KingPac Insight UAT: template only. Fill blank values in a protected Stack.env.
# The published image was inspected on 2026-11-20; use only after local release approval.
INSIGHT_SUPERSET_IMAGE=ghcr.io/kingpac-dev/kingpac-insight-uat@sha256:8c064141e753cffd76add29aa1d84289e176b8dfcfc5fa189cf2ae0fc4a2e86b

# Unique stable key: use a random secret >=32 characters from the secret manager.
SUPERSET_SECRET_KEY=
# PostgreSQL metadata credentials; never change existing volume credentials by editing this file alone.
INSIGHT_POSTGRES_USER=insight
INSIGHT_POSTGRES_DB=insight
INSIGHT_POSTGRES_PASSWORD=
# Host-loopback published port; remote operators must use an approved SSH tunnel.
INSIGHT_POSTGRES_PUBLISHED_PORT=15433
INSIGHT_REDIS_PUBLISHED_PORT=16380

# Initial administrator: password >=16 characters; remove after first successful bootstrap.
INSIGHT_ADMIN_USERNAME=
INSIGHT_ADMIN_EMAIL=
INSIGHT_ADMIN_PASSWORD=

# Local-only by default; use a verified private host IP only with approved network controls.
INSIGHT_BIND_IP=127.0.0.1
# 18089 avoids the default Redpanda console port 18088.
INSIGHT_PORT=18089
# Set true only after the trusted HTTPS proxy and header controls have been verified.
INSIGHT_HTTPS_ENABLED=false
INTEGRATION_NETWORK=lakehouse-uat-integration

# PostgreSQL and Redis use their own pinned images from the Compose defaults.
# Do not set INSIGHT_POSTGRES_IMAGE or INSIGHT_REDIS_IMAGE to the Superset image.
# Only add overrides if an administrator has separately approved compatible images.
